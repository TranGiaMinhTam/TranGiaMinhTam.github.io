{
  "name": "my-portfolio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "vitest run",
    "test:portfolio": "vitest run src/portfolio",
    "test:shell": "vitest run src/portfolio/shell",
    "test:identity": "vitest run src/portfolio/identity src/portfolio/shell/SectionBodyResolver.test.tsx",
    "check:portfolio": "node scripts/portfolio/check-boundaries.mjs",
    "check:shell:candidate": "node scripts/portfolio/check-boundaries.mjs --mode candidate",
    "check:shell:active": "node scripts/portfolio/check-boundaries.mjs --mode active",
    "measure:portfolio": "node scripts/portfolio/measure-build.mjs",
    "build:shell-candidate": "vite build --config scripts/portfolio/candidate/vite.config.mjs",
    "preview:shell-candidate": "vite preview --config scripts/portfolio/candidate/vite.config.mjs",
    "measure:shell-candidate": "node scripts/portfolio/measure-build.mjs --dist /private/tmp/portfolio-u02-candidate-dist --javascript-budget 307200 --css-budget 51200 --output artifacts/portfolio/u02/candidate.json",
    "verify:shell": "node scripts/portfolio/verify-shell.mjs",
    "build:identity-candidate": "vite build --config scripts/portfolio/identity-candidate/vite.config.mjs",
    "preview:identity-candidate": "vite preview --config scripts/portfolio/identity-candidate/vite.config.mjs",
    "measure:identity-candidate": "node scripts/portfolio/measure-build.mjs --dist /private/tmp/portfolio-u03-candidate-dist --javascript-budget 256000 --css-budget 24576 --output artifacts/portfolio/u03/candidate.json",
    "verify:identity:source": "node scripts/portfolio/verify-identity-questions.mjs --phase source",
    "verify:identity:candidate": "node scripts/portfolio/verify-identity-questions.mjs --phase candidate",
    "verify:identity:active": "node scripts/portfolio/verify-identity-questions.mjs --phase active",
    "test:research": "vitest run src/portfolio/research src/portfolio/shell/SectionBodyResolver.test.tsx",
    "build:research-candidate": "vite build --config scripts/portfolio/research-candidate/vite.config.mjs",
    "preview:research-candidate": "vite preview --config scripts/portfolio/research-candidate/vite.config.mjs",
    "measure:research-candidate": "node scripts/portfolio/measure-build.mjs --dist /private/tmp/portfolio-u04-candidate-dist --baseline artifacts/portfolio/u04/measurement-baseline.json --javascript-budget 250000 --css-budget 30720 --javascript-regression-percent 12 --css-regression-percent none --output artifacts/portfolio/u04/candidate.json",
    "check:research:source": "node scripts/portfolio/check-boundaries.mjs --mode research-source",
    "check:research:candidate": "node scripts/portfolio/check-boundaries.mjs --mode research-candidate",
    "check:research:active": "node scripts/portfolio/check-boundaries.mjs --mode research-active",
    "verify:research:source": "node scripts/portfolio/verify-research-data.mjs --phase source",
    "verify:research:candidate": "node scripts/portfolio/verify-research-data.mjs --phase candidate",
    "verify:research:active": "node scripts/portfolio/verify-research-data.mjs --phase active",
    "test:academic": "vitest run src/portfolio/academics src/portfolio/shell/SectionBodyResolver.test.tsx",
    "build:academic-candidate": "vite build --config scripts/portfolio/academic-candidate/vite.config.mjs",
    "preview:academic-candidate": "vite preview --config scripts/portfolio/academic-candidate/vite.config.mjs",
    "measure:academic-candidate": "node scripts/portfolio/measure-build.mjs --dist /private/tmp/portfolio-u05-candidate-dist --baseline artifacts/portfolio/u05/measurement-baseline.json --javascript-budget 274000 --css-budget 43008 --javascript-regression-percent 10 --css-regression-percent none --output artifacts/portfolio/u05/candidate.json",
    "check:academic:source": "node scripts/portfolio/check-boundaries.mjs --mode academic-source",
    "check:academic:candidate": "node scripts/portfolio/check-boundaries.mjs --mode academic-candidate",
    "check:academic:active": "node scripts/portfolio/check-boundaries.mjs --mode academic-active",
    "verify:academic:source": "node scripts/portfolio/verify-academic-evidence.mjs --phase source",
    "verify:academic:candidate": "node scripts/portfolio/verify-academic-evidence.mjs --phase candidate",
    "verify:academic:active": "node scripts/portfolio/verify-academic-evidence.mjs --phase active",
    "test:tools-fieldwork": "vitest run src/portfolio/impact src/portfolio/shell/SectionBodyResolver.test.tsx",
    "build:tools-fieldwork-candidate": "vite build --config scripts/portfolio/tools-fieldwork-candidate/vite.config.mjs",
    "preview:tools-fieldwork-candidate": "vite preview --config scripts/portfolio/tools-fieldwork-candidate/vite.config.mjs",
    "measure:tools-fieldwork-candidate": "node scripts/portfolio/measure-build.mjs --dist /private/tmp/portfolio-u06-candidate-dist --baseline artifacts/portfolio/u06/measurement-baseline.json --javascript-budget 285000 --css-budget 46080 --javascript-regression-percent 8 --css-regression-percent none --output artifacts/portfolio/u06/candidate.json",
    "check:tools-fieldwork:source": "node scripts/portfolio/check-boundaries.mjs --mode tools-fieldwork-source",
    "check:tools-fieldwork:candidate": "node scripts/portfolio/check-boundaries.mjs --mode tools-fieldwork-candidate",
    "check:tools-fieldwork:active": "node scripts/portfolio/check-boundaries.mjs --mode tools-fieldwork-active",
    "verify:tools-fieldwork:source": "node scripts/portfolio/verify-tools-fieldwork.mjs --phase source",
    "verify:tools-fieldwork:candidate": "node scripts/portfolio/verify-tools-fieldwork.mjs --phase candidate",
    "verify:tools-fieldwork:active": "node scripts/portfolio/verify-tools-fieldwork.mjs --phase active",
    "verify:recovery": "node scripts/portfolio/verify-recovery.mjs",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@chakra-ui/icons": "^2.2.4",
    "@chakra-ui/react": "^3.30.0",
    "@emotion/react": "^11.14.0",
    "@tailwindcss/vite": "^4.1.18",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "prettier": "3.7.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.51.0",
    "vite": "^7.2.4",
    "vite-tsconfig-paths": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
